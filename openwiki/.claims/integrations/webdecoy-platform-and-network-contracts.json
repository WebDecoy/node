        {
          "resource": "repo://packages/webdecoy/src/client.ts#L106-L144",
          "version": "repo-lines-v1:sha256:01749cbc9c4ba408036be1dc42c405e3e85846f8d8c46a9325a7555a73986e75:"
        }
