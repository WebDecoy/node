    {
      "id": "claim_db1bf1b3bf404b5283a0eae88d5afa02",
      "statement": "Authenticated detection is a POST to `/api/v1/sdk/detect`; timeout, connection, authentication, rate-limit, and other non-success conditions become errors, while a successful response is returned as the service detection response.",
