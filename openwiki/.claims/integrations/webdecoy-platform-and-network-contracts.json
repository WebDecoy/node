        {
          "resource": "repo://packages/webdecoy/src/sdk.ts#L140-L151",
          "version": "repo-lines-v1:sha256:7f469ddb1f3c5d3e329170d2c1416a0dab5e5e1b00b047654b2482fc9cbe7925:"
