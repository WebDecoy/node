        }
      ]
    },
    {
      "id": "claim_4016c322ef1c4b2c89e5304b46ce9667",
      "statement": "The server transport uses Web-standard `fetch` with JSON, bearer authorization, a configurable abort timeout, and a normalized base URL; the fetch transport ignores `tlsRejectUnauthorized=false` rather than disabling TLS certificate verification.",
