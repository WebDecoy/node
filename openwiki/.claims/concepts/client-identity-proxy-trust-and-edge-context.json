    {
      "id": "claim_3c2bc6e40650440d9ca2336040d7d0e3",
      "statement": "WebDecoy centrally resolves a client address with `resolveClientIp`; the resolver defaults to the connection peer, normalizes accepted IPv4/IPv6 forms, and deliberately treats forwarding headers as untrusted until `trustProxy` says otherwise.",
      "evidence": [
        {
          "resource": "repo://packages/webdecoy/src/client-ip.ts#L13-L18",
          "version": "repo-lines-v1:sha256:ce721cee1e0f58e095fa0c26664702b2cabc81186f298ab59a9c0230602450a9:"
