          "version": "repo-lines-v1:sha256:aeb2ec4364376164d2ca25f7a9560fc064f8c0eb34922c838e18df034fd22835:"
        }
      ]
    },
    {
      "id": "claim_eaf1eab51f304a849c7f33157bbaae60",
      "statement": "For missing, malformed, or topologically inconsistent trusted forwarding data, the resolver conservatively falls back to the peer rather than trusting farther-left header values; `X-Real-IP` and the last `X-Vercel-Forwarded-For` value are fallback sources only after proxy trust is enabled, and a valid XFF chain takes precedence.",
      "evidence": [
        {
          "resource": "repo://packages/webdecoy/src/client-ip.test.ts#L156-L177",
          "version": "repo-lines-v1:sha256:b508d3e97f6d18194203d89444bdcf3f10b3438d3a83533265494f452d2e1c39:"
