        }
      ]
    },
    {
      "id": "claim_da1a7d68e8c44e008241d531204bb648",
      "statement": "Forwarded address chains are evaluated from the right-hand, infrastructure-controlled end: numeric proxy trust selects the Nth `X-Forwarded-For` entry from the right, while CIDR trust walks from the peer right-to-left and stops at the first untrusted or malformed hop.",
      "evidence": [
        {
          "resource": "repo://packages/webdecoy/src/client-ip.test.ts#L122-L192",
          "version": "repo-lines-v1:sha256:53e5106563fa36b52cf621e93a0bdf1a74ebe8aadc093c0e25324b3ce85f404f:"
        },
